// Copy this file to Secrets.xcconfig (same folder) and fill in your values.
// Secrets.xcconfig is in .gitignore, so the key never reaches GitHub.

// Claude API key from https://console.anthropic.com (Settings, API keys).
// Without it the app still runs; photos and Say it fall back to asking you.
CLAUDE_API_KEY =

// Your Apple signing team (Xcode, Settings, Accounts). Optional if you pick it in Xcode.
DEVELOPMENT_TEAM =
